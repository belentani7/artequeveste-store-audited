# ---------------------------------------------------------------------------
# Arte Que Veste — variáveis de ambiente
#
# Copie para `.env` e preencha apenas o que a loja realmente usa. Nada aqui é
# obrigatório para o catálogo vazio de lançamento: sem Shopify a vitrine entra
# em "modo de preparação" (sem erro e sem produto inventado).
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
# Porta HTTP (padrão 3000) e ambiente. `production` ativa a CSP estrita, HSTS e
# o cache imutável de assets.
PORT=3000
NODE_ENV=development

# --- Shopify Storefront (catálogo, carrinho e checkout) ---------------------
# Crie uma Storefront API access token em Shopify > Configurações > Apps >
# Desenvolver apps para a loja. SOMENTE a Storefront API é usada aqui; o token
# de Admin nunca deve ser colocado no servidor desta loja.
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# --- Login de cliente (opcional) -------------------------------------------
# Sem estas variáveis o botão "Entrar" não é exibido e a loja funciona
# normalmente (catálogo, carrinho e checkout são públicos).
OAUTH_SERVER_URL=
JWT_SECRET=
DATABASE_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# --- Analítica opcional (LGPD: só carrega após consentimento) --------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
